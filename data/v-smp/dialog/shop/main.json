{
    "type": "minecraft:multi_action",
    "title": [
        {
            "text": "Welcome to the ",
            "hover_event": {
                "action": "show_text",
                "value": "You can purchase certain items here"
            }
        },
        {
            "text": "Item Shop",
            "color": "yellow",
            "hover_event": {
                "action": "show_text",
                "value": "You can purchase certain items here"
            }
        },
        {
            "text": "!",
            "hover_event": {
                "action": "show_text",
                "value": "You can purchase certain items here"
            }
        }
    ],
    "external_title": "Shop",
    "body": {
        "type": "minecraft:plain_message",
        "contents": {
            "text": "Here you can buy some of the custom items I created.",
            "color": "white"
        }
    },
    "inputs": [
        {
            "type": "minecraft:boolean",
            "key": "confirm",
            "label": {
                "text": "Confirm Purchase?"
            },
            "initial": false,
            "on_true": "1",
            "on_false": "0"
        }
    ],
    "can_close_with_escape": true,
    "exit_action": {
        "label": "Close Shop"
    },
    "actions": [
        {
            "label": {
                "atlas": "minecraft:items",
                "sprite": "minecraft:item/ender_pearl",
                "extra": [
                    " Infinity Pearl"
                ]
            },
            "tooltip": "1 Elytra",
            "width": 100,
            "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "trigger shop_pearl set $(confirm)"
            }
        },
        {
            "label": {
                "atlas": "minecraft:items",
                "sprite": "minecraft:item/firework_rocket",
                "extra": [
                    " Infinite Rocket"
                ]
            },
            "tooltip": "1 Elytra",
            "width": 100,
            "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "trigger shop_rocket set $(confirm)"
            }
        },
        {
            "label": {
                "atlas": "minecraft:items",
                "sprite": "minecraft:item/enchanted_book",
                "extra": [
                    " Unbreakable"
                ]
            },
            "tooltip": "64 Diamonds",
            "width": 100,
            "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "trigger shop_unbreakable set $(confirm)"
            }
        },
        {
            "label": {
                "atlas": "minecraft:items",
                "sprite": "minecraft:item/golden_shovel",
                "extra": [
                    " Speedy Shovel"
                ]
            },
            "tooltip": "32 Diamonds",
            "width": 100,
            "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "trigger shop_shovel set $(confirm)"
            }
        },
        {
            "label": {
                "atlas": "minecraft:gui",
                "sprite": "minecraft:icon/draft_report",
                "extra": [
                    " Magic 8-Ball"
                ]
            },
            "tooltip": "16 Diamonds",
            "width": 100,
            "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "trigger shop_8ball set $(confirm)"
            }
        },
        {
            "label": {
                "atlas": "minecraft:blocks",
                "sprite": "minecraft:block/spawner",
                "extra": [
                    " Spawner"
                ]
            },
            "width": 100,
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "v-smp:shop/spawner"
            }
        },
        {
            "label": {
                "atlas": "minecraft:items",
                "sprite": "minecraft:item/creeper_banner_pattern",
                "extra": [
                    " Animal Carrier"
                ]
            },
            "tooltip": "1 Diamond",
            "width": 100,
            "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "trigger shop_carrier set $(confirm)"
            }
        },
        {
            "label": {
                "atlas": "minecraft:items",
                "sprite": "minecraft:item/netherite_upgrade_smithing_template",
                "extra": [
                    " Cosmetic Key"
                ]
            },
            "width": 100,
            "tooltip": "10 Diamonds",
            "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "trigger cos_key set $(confirm)"
            }
        }
    ]
}